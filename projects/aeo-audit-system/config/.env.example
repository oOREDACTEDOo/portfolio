# ============================================
# AEO Audit System - Environment Configuration
# ============================================
# Copy this file to .env and fill in your credentials
# NEVER commit .env to version control!

# ============================================
# Reddit API Credentials
# ============================================
# Get from: https://www.reddit.com/prefs/apps
# Click "create app" -> Choose "script" type
REDDIT_CLIENT_ID=your_client_id_here
REDDIT_CLIENT_SECRET=your_client_secret_here
REDDIT_USER_AGENT=AEO_Audit_Bot/1.0_by_YourUsername

# ============================================
# Google APIs
# ============================================
# Knowledge Graph API (Optional but recommended)
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_KG_API_KEY=your_google_kg_api_key_here

# ============================================
# AI Testing APIs
# ============================================

# Anthropic Claude API
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API (for ChatGPT testing - if not using N8N scraper)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Perplexity API (Optional)
# Get from: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# ============================================
# DataForSEO API
# ============================================
# Get from: https://app.dataforseo.com/api-access
DATAFORSEO_LOGIN=your_dataforseo_login
DATAFORSEO_PASSWORD=your_dataforseo_password

# ============================================
# Flask Configuration
# ============================================
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_PORT=5000
FLASK_HOST=0.0.0.0

# Secret key for session management (generate random string)
FLASK_SECRET_KEY=change-this-to-random-secret-key-in-production

# ============================================
# API Security
# ============================================
# API key for N8N to authenticate requests (optional but recommended)
N8N_API_KEY=your-secure-n8n-api-key-here

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5678,https://your-n8n-instance.com

# ============================================
# Rate Limiting
# ============================================
# Requests per minute for external APIs
RATE_LIMIT_REDDIT=30
RATE_LIMIT_WIKIPEDIA=100
RATE_LIMIT_REVIEWS=10

# ============================================
# Scraping Configuration
# ============================================
# Number of days to look back for historical data
DEFAULT_DAYS_BACK=180

# Maximum results per platform
MAX_REDDIT_RESULTS=100
MAX_REVIEW_RESULTS=50

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=INFO
LOG_FILE=logs/aeo-audit.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# ============================================
# Caching (Optional - Redis)
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
CACHE_TTL=3600

# ============================================
# Database (Optional - for audit history)
# ============================================
DATABASE_URL=sqlite:///aeo_audits.db
# For PostgreSQL: postgresql://user:password@localhost:5432/aeo_audits

# ============================================
# Monitoring (Optional)
# ============================================
# Sentry DSN for error tracking
SENTRY_DSN=

# ============================================
# Development Flags
# ============================================
# Skip certain checks during development
SKIP_REDDIT=False
SKIP_REVIEWS=False
SKIP_KNOWLEDGE=False
SKIP_AI_TESTING=False

# Use mock data instead of real API calls
USE_MOCK_DATA=False

# ============================================
# Production Settings
# ============================================
# Set to True in production
PRODUCTION=False

# Max concurrent audit requests
MAX_CONCURRENT_AUDITS=5

# Request timeout (seconds)
REQUEST_TIMEOUT=30

# ============================================
# Report Generation
# ============================================
# Google Docs API (if using Google Docs for reports)
GOOGLE_DOCS_CREDENTIALS_FILE=config/google-credentials.json

# Report output directory
REPORT_OUTPUT_DIR=reports/

# PDF generation (if not using Google Docs)
PDF_TEMPLATE=templates/audit-report-template.html
